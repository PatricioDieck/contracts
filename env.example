# Copy this file to `.env` (recommended) and fill values.
# NOTE: `.env` is gitignored.

# RPC + key for Sepolia deployments (required if you use `--network sepolia`)
SEPOLIA_RPC_URL=
SEPOLIA_PRIVATE_KEY=

# After deployment, paste the deployed contract address here:
ESCROW_ADDRESS=

# OpenAI (required for scripts/ai-judge.ts)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Evidence source (local MVP)
EVIDENCE_DIR=./evidence
LOOKBACK_BLOCKS=5000

# Optional: deploy EscrowV01 with a specific aiJudge address (defaults to deployer)
AI_JUDGE_ADDRESS=


