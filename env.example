# =============================================================================
# Baby Bitcoin - Environment Template
# =============================================================================
# Copy this file to create your environment configs:
#   cp env.example env.hardhat   (for local dev)
#   cp env.example env.sepolia   (for testnet)
#   cp env.example env.mainnet   (for production)
#
# Then fill in your values. These files are gitignored.
# =============================================================================

# Chain: hardhat | sepolia | mainnet
NEXT_PUBLIC_CHAIN=hardhat

# RPC URL
# - hardhat: http://127.0.0.1:8545
# - sepolia: https://eth-sepolia.g.alchemy.com/v2/YOUR_KEY
# - mainnet: https://eth-mainnet.g.alchemy.com/v2/YOUR_KEY
NEXT_PUBLIC_RPC_URL=http://127.0.0.1:8545

# Contract address (from deployment output)
NEXT_PUBLIC_ESCROW_ADDRESS=0x...

# AI Judge public address
NEXT_PUBLIC_AI_JUDGE_ADDRESS=0x...

# WalletConnect Project ID (from cloud.walletconnect.com)
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# AI Judge private key (KEEP SECRET!)
AI_JUDGE_PRIVATE_KEY=0x...

# OpenAI API key
OPENAI_API_KEY=sk-...

